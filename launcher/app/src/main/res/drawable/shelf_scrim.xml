<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens the top (so the clock pill reads over a bright picture) and the bottom (so the dock and the tiles under it
     do) of a full screen shelf picture. It is the same in both themes: it sits over a photo, not over the theme's
     background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top" android:height="170dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#8C000000" android:endColor="#00000000" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="280dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#B3000000" android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
