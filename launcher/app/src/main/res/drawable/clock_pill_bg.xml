<?xml version="1.0" encoding="utf-8"?>
<!-- The clock pill. At rest the frosted pill; focused, the same pill with a ring (dark on the light theme,
     light on the dark one) instead of a solid white fill, which would hardly show on the light theme. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/pill_fill_top" android:endColor="@color/pill_fill_bottom" />
            <stroke android:width="3dp" android:color="@color/focus_ring" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/pill_fill_top" android:endColor="@color/pill_fill_bottom" />
            <stroke android:width="1dp" android:color="@color/pill_stroke" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
