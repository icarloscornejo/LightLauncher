<?xml version="1.0" encoding="utf-8"?>
<!-- A settings row, glass at rest and solid white with the focus (the text colours flip with
     pill_text and pill_text_dim). The fade makes the change a soft one rather than a switch. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_fill" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_row" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
